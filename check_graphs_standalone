#!/usr/bin/env python3
"""
Standalone graph checker - checks if graphs have more spanning trees than a baseline.

This script is self-contained with no external dependencies except networkx, numpy, and scipy.

Usage:
    check_graphs_standalone --baseline-T 32.0 test_graphs.json
    check_graphs_standalone --baseline-T 32.0 test_graphs.json --output results.json
"""

import argparse
import json
import sys
import networkx as nx
import numpy as np


def count_spanning_trees(G):
    """
    Count spanning trees using Kirchhoff's matrix tree theorem.
    Returns ln(number of spanning trees) to avoid overflow.
    """
    if not nx.is_connected(G):
        return float('-inf')

    # Get Laplacian matrix
    L = nx.laplacian_matrix(G).toarray()

    # Remove last row and column (Kirchhoff's theorem)
    L_reduced = L[:-1, :-1]

    # Compute determinant using sign and logdet to avoid overflow
    sign, logdet = np.linalg.slogdet(L_reduced)

    if sign <= 0:
        return float('-inf')

    return logdet


def load_graphs_from_json(json_file):
    """Load graphs from JSON file (adjacency lists)."""
    with open(json_file, 'r') as f:
        data = json.load(f)

    graphs = []
    for item in data:
        # Support both dict format and just adjacency list
        if isinstance(item, dict):
            adj_list = item.get('adjacency_list', item.get('graph'))
            name = item.get('name', f'graph_{len(graphs)}')
        else:
            adj_list = item
            name = f'graph_{len(graphs)}'

        # Convert adjacency list to graph
        G = nx.Graph()
        for node, neighbors in enumerate(adj_list):
            for neighbor in neighbors:
                if node < neighbor:  # Avoid duplicate edges
                    G.add_edge(node, neighbor)

        graphs.append((name, G))

    return graphs


def main():
    parser = argparse.ArgumentParser(
        description='Check if test graphs have more spanning trees than baseline threshold',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  check_graphs_standalone --baseline-T 32.0 test_graphs.json
  check_graphs_standalone --baseline-T 32.0 test_graphs.json --output results.json
  check_graphs_standalone --baseline-T 32.0 test_graphs.json --verbose
        """
    )

    parser.add_argument('--baseline-T', type=float, required=True,
                       help='Baseline threshold: ln(number of spanning trees)')
    parser.add_argument('test_graphs',
                       help='JSON file with test graphs (adjacency lists)')
    parser.add_argument('--verbose', '-v', action='store_true',
                       help='Show detailed output')
    parser.add_argument('--output', '-o',
                       help='Output results to file (JSON format)')

    args = parser.parse_args()

    baseline_T = args.baseline_T
    baseline_name = f"threshold_{baseline_T:.4f}"

    if args.verbose:
        print(f"Using baseline threshold: ln(T) = {baseline_T:.6f}")
        print()

    # Load test graphs
    test_graphs = load_graphs_from_json(args.test_graphs)

    if args.verbose:
        print(f"Loaded {len(test_graphs)} test graphs from {args.test_graphs}")
        print()

    # Check each graph
    results = []
    num_passed = 0

    print(f"{'Graph Name':<30} {'N':>5} {'ln(trees)':>12} {'Result':<10}")
    print("-" * 65)

    for name, G in test_graphs:
        # Compute spanning tree count
        T_test = count_spanning_trees(G)

        # Check against baseline
        has_more = T_test > baseline_T

        result_str = "PASS ✓" if has_more else "FAIL ✗"
        if has_more:
            num_passed += 1

        print(f"{name:<30} {G.number_of_nodes():>5} {T_test:>12.6f} {result_str:<10}")

        results.append({
            'name': name,
            'n': int(G.number_of_nodes()),
            'ln_trees': float(T_test),
            'has_more_than_baseline': bool(has_more)
        })

    print("-" * 65)
    print(f"\nSummary: {num_passed}/{len(test_graphs)} graphs beat baseline")

    # Save results if requested
    if args.output:
        output_data = {
            'baseline': baseline_name,
            'baseline_ln_trees': float(baseline_T),
            'test_file': args.test_graphs,
            'results': results,
            'summary': {
                'total': len(test_graphs),
                'passed': num_passed,
                'failed': len(test_graphs) - num_passed
            }
        }

        with open(args.output, 'w') as f:
            json.dump(output_data, f, indent=2)

        print(f"\nResults saved to: {args.output}")

    # Exit code: 0 if all pass, 1 if any fail
    sys.exit(0 if num_passed == len(test_graphs) else 1)


if __name__ == "__main__":
    main()
