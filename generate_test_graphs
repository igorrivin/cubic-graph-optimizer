#!/usr/bin/env python3
"""
Generate test graphs for checker: 1 optimized + N random cubic graphs.

Usage:
    generate_test_graphs N [--num-random 9] [--output test_graphs.json]
    generate_test_graphs --from-file optimized.pkl [--num-random 9]
"""

import argparse
import json
import networkx as nx
from pathlib import Path

from cubic_graph_optimizer.optimization.methods import optimize_with_restarts
from cubic_graph_optimizer.core.spanning_trees import count_spanning_trees
from cubic_graph_optimizer.utils.io import load_graph, save_graph


def graph_to_adjacency_list(G):
    """Convert graph to adjacency list format."""
    n = G.number_of_nodes()
    adj_list = [[] for _ in range(n)]

    for node in range(n):
        adj_list[node] = sorted(list(G.neighbors(node)))

    return adj_list


def main():
    parser = argparse.ArgumentParser(
        description='Generate test graphs: 1 optimized + random cubic graphs',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  generate_test_graphs 40 --num-random 9
  generate_test_graphs --from-file optimized_n40.pkl --num-random 9
  generate_test_graphs 30 --num-random 5 --output my_tests.json
        """
    )

    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('N', type=int, nargs='?',
                      help='Number of vertices (will optimize a new graph)')
    group.add_argument('--from-file', type=str,
                      help='Load optimized graph from file instead')

    parser.add_argument('--num-random', type=int, default=9,
                       help='Number of random graphs to generate (default: 9)')
    parser.add_argument('--output', '-o', default='test_graphs.json',
                       help='Output JSON file (default: test_graphs.json)')
    parser.add_argument('--method', default='first',
                       choices=['greedy', 'first', 'first-multifold', 'sa', 'sa-multifold'],
                       help='Optimization method if generating new graph (default: first)')
    parser.add_argument('--max-iterations', type=int, default=100,
                       help='Max iterations for optimization (default: 100)')
    parser.add_argument('--seed', type=int, default=42,
                       help='Random seed (default: 42)')

    args = parser.parse_args()

    graphs = []

    # Get optimized graph
    if args.from_file:
        print(f"Loading optimized graph from {args.from_file}...")
        G_opt = load_graph(args.from_file)
        n = G_opt.number_of_nodes()
        T_opt = count_spanning_trees(G_opt)
        print(f"  N={n}, ln(trees)={T_opt:.6f}")
    else:
        n = args.N
        if n % 2 != 0:
            parser.error("N must be even")

        print(f"Optimizing graph with N={n}...")
        G_opt, T_opt, _ = optimize_with_restarts(
            n=n,
            method=args.method,
            restarts=1,
            base_seed=args.seed,
            verbose=True,
            max_iterations=args.max_iterations
        )
        print(f"  Optimized: ln(trees)={T_opt:.6f}")

        # Save the optimized graph for future use
        opt_filename = f"optimized_n{n}_{args.method}.pkl"
        save_graph(G_opt, opt_filename, T_value=T_opt)
        print(f"  Saved to: {opt_filename}")

    # Add optimized graph
    graphs.append({
        'name': 'optimized',
        'adjacency_list': graph_to_adjacency_list(G_opt),
        'ln_trees': T_opt,
        'source': 'optimized'
    })

    # Generate random cubic graphs
    print(f"\nGenerating {args.num_random} random cubic graphs...")
    for i in range(args.num_random):
        seed = args.seed + 1000 + i
        G_random = nx.random_regular_graph(3, n, seed=seed)
        T_random = count_spanning_trees(G_random)

        graphs.append({
            'name': f'random_{i+1}',
            'adjacency_list': graph_to_adjacency_list(G_random),
            'ln_trees': T_random,
            'source': 'random',
            'seed': seed
        })

        print(f"  random_{i+1}: ln(trees)={T_random:.6f}")

    # Save to JSON
    output_path = Path(args.output)
    with open(output_path, 'w') as f:
        json.dump(graphs, f, indent=2)

    print(f"\nSaved {len(graphs)} graphs to: {output_path}")
    print(f"  1 optimized (ln(trees)={T_opt:.6f})")
    print(f"  {args.num_random} random")

    # Print command to check them
    if args.from_file:
        baseline = args.from_file
    else:
        baseline = f"optimized_n{n}_{args.method}.pkl"

    print(f"\nTo check these graphs, run:")
    print(f"  ./check_graphs {baseline} {output_path}")


if __name__ == "__main__":
    main()
