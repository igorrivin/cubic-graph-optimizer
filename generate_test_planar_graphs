#!/usr/bin/env python3
"""Generate test graphs for planar cubic graph checker."""

import sys
import json
sys.path.insert(0, '.')

from cubic_graph_optimizer.planar.triangulation import random_triangulation_from_sphere, triangulation_to_dual_cubic
from cubic_graph_optimizer.planar.alternating_planar import alternating_planar_optimization
from cubic_graph_optimizer.planar.planar_ops import random_planar_cubic_from_sphere
from cubic_graph_optimizer.core.spanning_trees import count_spanning_trees, get_second_eigenvalue


def graph_to_adjacency_list(G):
    """Convert graph to adjacency list format."""
    n = G.number_of_nodes()
    adj_list = [[] for _ in range(n)]
    for u, v in G.edges():
        adj_list[u].append(v)
        adj_list[v].append(u)
    # Sort for consistency
    for neighbors in adj_list:
        neighbors.sort()
    return adj_list


def main():
    print("Generating test planar cubic graphs...")
    test_graphs = []

    # 1. Generate optimized N≈40 planar cubic graph (GOOD - should pass)
    print("\n1. Generating optimized N≈40 planar cubic graph...")
    G_tri, _ = random_triangulation_from_sphere(22, seed=42)
    G_tri_opt, G_dual_opt, stats = alternating_planar_optimization(
        G_tri,
        max_cycles=10,
        max_iterations_per_phase=100,
        verbose=False
    )

    trees = count_spanning_trees(G_dual_opt)
    lambda2 = get_second_eigenvalue(G_dual_opt)

    print(f"   N={G_dual_opt.number_of_nodes()}, ln(trees)={trees:.6f}, λ₂={lambda2:.6f}")

    test_graphs.append({
        'name': 'planar_n40_optimized_alternating',
        'adjacency_list': graph_to_adjacency_list(G_dual_opt),
        'expected': True,
        'description': f'Optimized planar cubic N=40 via alternating (trees={trees:.3f}, λ₂={lambda2:.3f})',
        'ln_trees': trees,
        'lambda2': lambda2,
    })

    # 2. Generate several random N=40 planar cubic graphs (BAD - should fail)
    print("\n2. Generating random N≈40 planar cubic graphs...")
    for i, seed in enumerate([123, 456, 789]):
        G_random = random_planar_cubic_from_sphere(22, seed=seed)

        trees = count_spanning_trees(G_random)
        lambda2 = get_second_eigenvalue(G_random)

        print(f"   Random {i+1}: N={G_random.number_of_nodes()}, ln(trees)={trees:.6f}, λ₂={lambda2:.6f}")

        test_graphs.append({
            'name': f'planar_n40_random_{i+1}',
            'adjacency_list': graph_to_adjacency_list(G_random),
            'expected': False,
            'description': f'Random planar cubic N=40 (trees={trees:.3f}, λ₂={lambda2:.3f})',
            'ln_trees': trees,
            'lambda2': lambda2,
        })

    # 3. Generate optimized N=12 (icosahedron dual - should be GREAT)
    print("\n3. Generating optimized N=12 planar cubic graph...")
    G_tri_12, _ = random_triangulation_from_sphere(12, seed=42)
    G_tri_12_opt, G_dual_12_opt, stats_12 = alternating_planar_optimization(
        G_tri_12,
        max_cycles=10,
        max_iterations_per_phase=50,
        verbose=False
    )

    trees_12 = count_spanning_trees(G_dual_12_opt)
    lambda2_12 = get_second_eigenvalue(G_dual_12_opt)

    print(f"   N={G_dual_12_opt.number_of_nodes()}, ln(trees)={trees_12:.6f}, λ₂={lambda2_12:.6f}")
    print(f"   (This should be the dodecahedron, dual of icosahedron)")

    test_graphs.append({
        'name': 'planar_n20_optimized_dodecahedron',
        'adjacency_list': graph_to_adjacency_list(G_dual_12_opt),
        'expected': True,
        'description': f'Optimized N=20 (dodecahedron) via alternating (trees={trees_12:.3f}, λ₂={lambda2_12:.3f})',
        'ln_trees': trees_12,
        'lambda2': lambda2_12,
    })

    # Save to JSON
    output_file = 'test_planar_graphs.json'
    with open(output_file, 'w') as f:
        json.dump(test_graphs, f, indent=2)

    print(f"\n{'='*70}")
    print(f"Generated {len(test_graphs)} test graphs")
    print(f"Saved to: {output_file}")
    print(f"{'='*70}")

    # Print summary
    print("\nSummary:")
    for g in test_graphs:
        expected_str = "GOOD" if g['expected'] else "BAD"
        print(f"  {expected_str:4s} - {g['name']}: {g['description']}")

    print(f"\nRecommended baseline thresholds:")
    optimized_trees = [g['ln_trees'] for g in test_graphs if g['expected']]
    random_trees = [g['ln_trees'] for g in test_graphs if not g['expected']]

    optimized_lambda2 = [g['lambda2'] for g in test_graphs if g['expected']]
    random_lambda2 = [g['lambda2'] for g in test_graphs if not g['expected']]

    if optimized_trees and random_trees:
        # Set baseline between worst optimized and best random
        baseline_trees = (min(optimized_trees) + max(random_trees)) / 2
        print(f"  --baseline-trees {baseline_trees:.3f}")

    if optimized_lambda2 and random_lambda2:
        # Set baseline between worst optimized and best random
        baseline_lambda2 = (max(optimized_lambda2) + min(random_lambda2)) / 2
        print(f"  --baseline-lambda2 {baseline_lambda2:.3f}")


if __name__ == '__main__':
    main()
