#!/usr/bin/env python3
"""
Launch the Gradio web interface for cubic graph optimizer.

Usage:
    ./launch_ui              # Launch on localhost:7860
    ./launch_ui --share      # Create a public shareable link
    ./launch_ui --port 8080  # Use custom port
"""

import argparse
from cubic_graph_optimizer.ui import launch_ui


def main():
    parser = argparse.ArgumentParser(
        description="Launch Gradio web interface for cubic graph optimizer"
    )

    parser.add_argument(
        '--share',
        action='store_true',
        help='Create a public shareable link'
    )

    parser.add_argument(
        '--server-name',
        default='127.0.0.1',
        help='Server hostname (default: 127.0.0.1)'
    )

    parser.add_argument(
        '--port',
        type=int,
        default=7860,
        help='Server port (default: 7860)'
    )

    args = parser.parse_args()

    print("="*70)
    print("Cubic Graph Optimizer - Web Interface")
    print("="*70)
    print(f"Starting server on {args.server_name}:{args.port}")
    if args.share:
        print("Creating public shareable link...")
    print("="*70)
    print()

    launch_ui(
        share=args.share,
        server_name=args.server_name,
        server_port=args.port
    )


if __name__ == "__main__":
    main()
