#!/usr/bin/env python3
"""
Launch the enhanced Gradio UI with alternating optimization.
"""

import argparse
import sys

# Add package to path if needed
sys.path.insert(0, '/home/igor/devel/cubic-graph-optimizer')

from cubic_graph_optimizer.ui_enhanced import launch_ui

def main():
    parser = argparse.ArgumentParser(description='Launch enhanced Cubic Graph Optimizer UI')
    parser.add_argument('--share', action='store_true',
                       help='Create a public share link')
    parser.add_argument('--port', type=int, default=7860,
                       help='Port to run server on (default: 7860)')
    parser.add_argument('--server-name', type=str, default='127.0.0.1',
                       help='Server name/IP (default: 127.0.0.1)')

    args = parser.parse_args()

    print("=" * 70)
    print("Launching Enhanced Cubic Graph Optimizer UI")
    print("=" * 70)
    print(f"Server: http://{args.server_name}:{args.port}")
    if args.share:
        print("Public link will be generated...")
    print("=" * 70)
    print()

    launch_ui(
        share=args.share,
        server_name=args.server_name,
        server_port=args.port
    )

if __name__ == "__main__":
    main()
