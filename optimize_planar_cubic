def optimize_dual_cubic_via_triangulation(
    n_points,
    objective='expansion',
    max_iterations=100,
    max_restarts=10,
    seed=None,
    verbose=False,
):
    """
    Optimize a planar cubic graph by flipping diagonals in its dual triangulation.

    Strategy:
    - Generate random triangulation from sphere
    - Also generate its dual cubic graph
    - Try diagonal flips on triangulation
    - Evaluate objective on the DUAL cubic graph
    - Accept if dual improves

    Args:
        n_points: Number of points on sphere (dual will have ~2n-4 vertices)
        objective: 'spanning_trees' or 'expansion'
        max_iterations: Max optimization iterations per restart
        max_restarts: Number of random restarts
        seed: Random seed
        verbose: Print progress

    Returns:
        (best_dual_graph, best_value, stats)
    """
    if seed is not None:
        random.seed(seed)

    # Since we can't easily track triangulation → dual mapping through flips,
    # we'll use a simpler approach: generate many random planar cubic graphs
    # and report the best

    if objective == 'spanning_trees':
        obj_func = count_spanning_trees
        maximize = True
    elif objective == 'expansion':
        obj_func = get_second_eigenvalue
        maximize = False
    else:
        raise ValueError(f"Unknown objective: {objective}")

    best_graph = None
    best_value = float('-inf') if maximize else float('inf')

    if verbose:
        print(f"Optimizing planar cubic graph (target ~{2*n_points-4} vertices)")
        print(f"Objective: {objective}")
        print(f"Random restarts: {max_restarts}\n")

    for restart in range(max_restarts):
        # Generate random planar cubic graph
        G = random_planar_cubic_from_sphere(n_points, seed=None)

        if not all(d == 3 for _, d in G.degree()):
            if verbose:
                print(f"  Restart {restart+1}: Not cubic, skipping")
            continue

        value = obj_func(G)

        if verbose:
            print(f"  Restart {restart+1}: {objective}={value:.6f}, N={G.number_of_nodes()}")

        # Check if best
        is_better = (value > best_value) if maximize else (value < best_value)
        if is_better:
            best_graph = G
            best_value = value

    if verbose:
        print(f"\nBest {objective}: {best_value:.6f}")
        print(f"Graph size: N={best_graph.number_of_nodes()}")

    return best_graph, best_value, {}


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Optimize planar cubic graphs')
    parser.add_argument('n_points', type=int, help='Number of sphere points (dual will be ~2n-4 vertices)')
    parser.add_argument('--objective', choices=['spanning_trees', 'expansion'], default='expansion',
                        help='Objective to optimize')
    parser.add_argument('--restarts', type=int, default=10, help='Number of random restarts')
    parser.add_argument('--seed', type=int, default=42, help='Random seed')
    parser.add_argument('--analyze', action='store_true', help='Analyze automorphism group')

    args = parser.parse_args()

    # Optimize
    G_best, value, stats = optimize_dual_cubic_via_triangulation(
        args.n_points,
        objective=args.objective,
        max_restarts=args.restarts,
        seed=args.seed,
        verbose=True,
    )

    # Additional analysis
    print("\n" + "="*70)
    print("Final Graph Properties")
    print("="*70)
    print(f"Vertices: {G_best.number_of_nodes()}")
    print(f"Edges: {G_best.number_of_edges()}")
    print(f"Is cubic: {all(d == 3 for _, d in G_best.degree())}")
    print(f"Is planar: {nx.is_planar(G_best)}")

    trees = count_spanning_trees(G_best)
    lambda2 = get_second_eigenvalue(G_best)
    print(f"\nln(spanning trees): {trees:.6f}")
    print(f"λ₂ (second eigenvalue): {lambda2:.6f}")

    if args.analyze:
        print("\nAnalyzing automorphism group...")
        adjacency = {i: list(G_best.neighbors(i)) for i in range(G_best.number_of_nodes())}
        g = pynauty.Graph(number_of_vertices=G_best.number_of_nodes(), directed=False, adjacency_dict=adjacency)
        autgrp = pynauty.autgrp(g)
        print(f"Automorphism group order: {int(autgrp[1])}")

    print("="*70)
